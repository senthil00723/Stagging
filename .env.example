# Tenant API DB connection: NON-superuser role subject to Row-Level Security
DATABASE_URL=postgres://g3_app:g3_app_dev@localhost:5432/g3leads
# Platform (super-admin) DB connection: BYPASSRLS role, used ONLY by /admin-api
PLATFORM_DATABASE_URL=postgres://g3_platform:g3_platform_dev@localhost:5432/g3leads
# Migration connection: owner/superuser
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/g3leads

# Distinct secrets AND audiences per portal (spec §2A)
TENANT_JWT_SECRET=change-me-tenant-secret-at-least-32-chars-long
ADMIN_JWT_SECRET=change-me-admin-secret-at-least-32-chars-long-xx
# Comma separated IPs; empty = allow all (dev only)
ADMIN_IP_ALLOWLIST=
API_PORT=4000
