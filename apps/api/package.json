{
  "name": "@g3/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/seed.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@g3/db": "workspace:*",
    "@g3/shared": "workspace:*",
    "@hono/node-server": "2.1.5",
    "@hono/zod-openapi": "1.6.3",
    "@node-rs/argon2": "2.2.2",
    "@scalar/hono-api-reference": "0.12.12",
    "hono": "4.13.13",
    "jose": "6.2.12",
    "otplib": "13.5.0",
    "pino": "10.4.0",
    "postgres": "3.4.9",
    "qrcode": "1.5.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/qrcode": "1.5.6",
    "tsx": "4.23.15",
    "vitest": "5.0.4"
  }
